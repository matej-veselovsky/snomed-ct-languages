{
  "name": "snomed-ct-languages",
  "displayName": "SNOMED CT Languages",
  "description": "Snomed CT Languages for VS Code.",
  "version": "0.0.3",
  "engines": {
    "vscode": "^1.0.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "repository": {
    "type": "git",
    "url": "git@github.com:matej-veselovsky/snomed-ct-languages.git"
  },
  "publisher": "crno",
  "license": "Apache-2.0",
  "contributes": {
    "languages": [
      {
        "id": "snomed-scg",
        "aliases": [
          "SNOMED CT Compositional Grammar",
          "snomed-scg"
        ],
        "extensions": [
          "scg"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "snomed-etl",
        "aliases": [
          "SNOMED CT Expression Template Language",
          "snomed-etl"
        ],
        "extensions": [
          "etl"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "snomed-ecl",
        "aliases": [
          "SNOMED CT Expression Constraint Language",
          "snomed-ecl"
        ],
        "extensions": [
          "ecl"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "snomed-scg",
        "scopeName": "source.snomed-scg",
        "path": "./syntaxes/snomed-scg.tmLanguage.json"
      },
      {
        "language": "snomed-etl",
        "scopeName": "source.snomed-etl",
        "path": "./syntaxes/snomed-etl.tmLanguage.json"
      },
      {
        "language": "snomed-ecl",
        "scopeName": "source.snomed-ecl",
        "path": "./syntaxes/snomed-ecl.tmLanguage.json"
      }
    ]
  },
  "main": "./src/extension.js",
  "activationEvents": [
    "onLanguage:snomed-scg",
    "onLanguage:snomed-etl",
    "onLanguage:snomed-ecl"
  ]
}